                  "  pm.response.to.have.status(401);",
                  "  pm.expect(pm.response.json().code).to.eql('INVALID_REFRESH_TOKEN');",
                  "});"
                ]
              }
            }
          ],
          "protocolProfileBehavior": { "disableCookies": true },
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Cookie", "value": "mn360_refresh={{refreshAtual}}" }],
            "url": "{{baseUrl}}/api/v1/auth/refresh"
          }
        }
      ]
    },
    {
      "name": "4. Bloqueio por tentativas (usuário USUARIO)",
      "item": [
        {
          "name": "Senha incorreta (repete 5 vezes)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('401 INVALID_CREDENTIALS', () => pm.response.to.have.status(401));",
                  "const falhas = Number(pm.collectionVariables.get('falhas')) + 1;",
                  "pm.collectionVariables.set('falhas', falhas);",
                  "console.log('Falha', falhas, 'de 5');",
                  "if (falhas < 5) {",
                  "  pm.execution.setNextRequest(pm.info.requestName); // no Runner; manualmente, envie 5 vezes",
                  "} else {",
                  "  pm.collectionVariables.set('falhas', 0);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{emailUsuario}}\",\n  \"senha\": \"senha-errada-123\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/api/v1/auth/login"
          }
        },
        {
          "name": "Senha correta durante o bloqueio",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
