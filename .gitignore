# Segredos e configuração local (RNF-005): versiona-se apenas os modelos .env.example
.env
.env.*
!.env.example

# Arquivos locais de editor e sistema
.DS_Store
Thumbs.db
*.log

# Artefatos de build (cada serviço também tem seu próprio .gitignore)
node_modules/
dist/

# Python (serviços de backend)
.venv/
__pycache__/
*.py[cod]
.ruff_cache/
.pytest_cache/
.coverage
htmlcov/
