# MeuNegocio360 - variáveis de ambiente do backend e do docker compose
#
# 1. Copie este arquivo:   cp .env.example .env
# 2. Preencha os valores marcados como OBRIGATÓRIO (campos vazios de propósito).
# 3. NUNCA versione o arquivo .env nem cole seu conteúdo em prompts de IA.
#
# Formato compatível com docker compose e com spring.config.import
# (optional:file:../.env[.properties]): uma variável por linha, sem aspas.

# ---------------------------------------------------------------------------
# Perfil do Spring
# ---------------------------------------------------------------------------
SPRING_PROFILES_ACTIVE=dev

# ---------------------------------------------------------------------------
# Banco de dados do Núcleo (usado pelo compose.yaml e pela aplicação)
# Cada microsserviço tem o seu próprio banco; novos serviços ganham novas variáveis.
# ---------------------------------------------------------------------------
CORE_DB_NAME=meunegocio360_core
CORE_DB_PORT=3306
DB_USER=meunegocio360
# OBRIGATÓRIO: senha do usuário da aplicação
DB_PASSWORD=
# OBRIGATÓRIO: senha do root do MySQL (somente para o contêiner local)
MYSQL_ROOT_PASSWORD=
# A porta e o nome do banco devem coincidir com CORE_DB_PORT e CORE_DB_NAME
DB_URL=jdbc:mysql://localhost:3306/meunegocio360_core?serverTimezone=UTC

# ---------------------------------------------------------------------------
# Segurança (RF-BE-001)
# ---------------------------------------------------------------------------
# OBRIGATÓRIO: segredo de assinatura do JWT, mínimo de 32 bytes.
# A aplicação deve falhar ao iniciar se estiver vazio ou curto. Gere com:
#   openssl rand -base64 48 (usar o Git Bash ou WSL no Windows)
JWT_SECRET=

# Origens do frontend permitidas, separadas por vírgula (CORS e verificação de Origin do
# refresh token). Em produção, informe a URL do site no Netlify. Nunca use *.
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Cookie do refresh token: "true" por padrão. Use "false" somente em dev, se o
# ambiente local não suportar cookies Secure em HTTP.
APP_AUTH_COOKIE_SECURE=true

# Opcionais, com os padrões do requisito RF-BE-001 (descomente para alterar):
# APP_AUTH_MAX_TENTATIVAS=5
# APP_AUTH_BLOQUEIO_MINUTOS=15
# APP_AUTH_JWT_EXPIRACAO_MINUTOS=15
# APP_AUTH_REFRESH_EXPIRACAO_DIAS=7

# ---------------------------------------------------------------------------
# Seed de desenvolvimento (somente perfil dev; NUNCA em produção) - mínimo de 8 caracteres
# OBRIGATÓRIO no perfil dev: senhas dos usuários fictícios criados na carga inicial
# ---------------------------------------------------------------------------
SEED_ADMIN_SENHA=
SEED_USUARIO_SENHA=
